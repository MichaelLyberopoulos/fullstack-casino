# PostgreSQL connection string
DATABASE_URL="postgresql://casino:casino_dev_password@localhost:5432/casino?schema=public"

# Secret used to sign JWTs — use a long random value in production
JWT_SECRET="change-me"

# JWT lifetime (kept short: tokens are stored client-side)
JWT_EXPIRES_IN="2h"

# HTTP port the API listens on
PORT=4000

# Comma-separated list of allowed CORS origins (the frontend URL)
CORS_ORIGIN="http://localhost:3000"
